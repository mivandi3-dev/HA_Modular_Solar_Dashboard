# Samostalni Solarni poslužitelj (bez Home Assistanta): docker compose up -d  (vidi docker-compose.yml)
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends iproute2 tzdata && rm -rf /var/lib/apt/lists/*
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY app /app
WORKDIR /app
ENV SOLARI_DATA_DIR=/data SOLARI_TOKEN_FILE=/data/share/api_token SOLARI_PUBLISH_SENSORS=0
EXPOSE 8700
CMD ["python", "-m", "solari_server"]
